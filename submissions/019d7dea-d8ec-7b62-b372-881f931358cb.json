{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "challenger_gemini_api_key": {
        "type": "string",
        "secret": true
      },
      "challenger_llm_model": {
        "type": "string",
        "default": "gpt-4.1-mini"
      },
      "challenger_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "challenger_openrouter_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "games": 10,
          "max_rounds": 5,
          "discount": 0.98,
          "bootstrap": 100,
          "full_matrix": true
        },
        "participant_roles": {
          "green": "green",
          "purple1": "challenger"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}",
          "purple1": "${bindings.purple1-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/MAizeBargAIn-agentbeats/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {}
    },
    "challenger": {
      "manifest": "https://raw.githubusercontent.com/jenova13q/j13_agentbeats-purple-agent/main/amber-manifest.json5",
      "config": {
        "gemini_api_key": "${config.challenger_gemini_api_key}",
        "llm_model": "${config.challenger_llm_model}",
        "openai_api_key": "${config.challenger_openai_api_key}",
        "openrouter_api_key": "${config.challenger_openrouter_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#challenger.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    },
    {
      "to": "#challenger.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "purple1-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019cfd96-75cb-7873-80ee-60683ace10be",
      "challenger": "019d7d30-dc21-7532-a278-6cd3e4317408"
    }
  }
}