{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "challenger_agent_logs_dir": {
        "type": "string",
        "default": "./logs"
      },
      "challenger_agent_memory_dir": {
        "type": "string",
        "default": "./memory"
      },
      "challenger_mistral_api_key": {
        "type": "string",
        "secret": true
      },
      "challenger_mistral_model": {
        "type": "string",
        "default": "mistral-small-latest"
      }
    },
    "required": [
      "challenger_mistral_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "games": 10,
          "max_rounds": 5,
          "discount": 0.98,
          "bootstrap": 100,
          "full_matrix": true
        },
        "participant_roles": {
          "green": "green",
          "purple1": "challenger"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}",
          "purple1": "${bindings.purple1-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/MAizeBargAIn-agentbeats/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {}
    },
    "challenger": {
      "manifest": "https://raw.githubusercontent.com/mrpetrakova2000/purple_agent_AITH/refs/heads/main/amber-manifest.json5",
      "config": {
        "agent_logs_dir": "${config.challenger_agent_logs_dir}",
        "agent_memory_dir": "${config.challenger_agent_memory_dir}",
        "mistral_api_key": "${config.challenger_mistral_api_key}",
        "mistral_model": "${config.challenger_mistral_model}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#challenger.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    },
    {
      "to": "#challenger.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "purple1-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019cfd96-75cb-7873-80ee-60683ace10be",
      "challenger": "019d68cc-ce20-7990-9425-312f6b9f1a11"
    }
  }
}